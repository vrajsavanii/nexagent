# ── NexAgent Environment Variables ─────────────────────────────────────────
# Copy this file to .env.local and fill in your actual values.
# .env.local is git-ignored and NEVER committed.

# ── Resend (email delivery for leads) ──────────────────────────────────────
# Get your key at: https://resend.com/api-keys
RESEND_API_KEY=re_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# The "from" address for lead notification emails (must be verified in Resend)
LEAD_EMAIL_FROM=leads@nexagent.io

# The "to" address where lead emails are delivered (your team inbox)
LEAD_EMAIL_TO=team@nexagent.io

# ── Slack (real-time lead notifications) ───────────────────────────────────
# Create a Slack App → Enable Incoming Webhooks → copy URL here
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXXXXXXXX/XXXXXXXXX/XXXXXXXXXXXXXXXXXXXXXXXXX

# ── Next.js App URL (for absolute URL generation in API routes) ────────────
NEXT_PUBLIC_APP_URL=https://nexagent.io
